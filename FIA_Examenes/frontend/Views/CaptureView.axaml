<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="frontend.Views.CaptureView"
             Background="#F1F5F9">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Banner Superior -->
        <Border Grid.Row="0" Background="#0C3B7C" Padding="15">
            <DockPanel>
                <TextBlock Text="UPQ | Control de Cámara y Captura" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Text="Estado: Listo" Foreground="#93C5FD" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 280" Margin="15">
            <!-- Área de Visualización de Imagen -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Margin="0,0,15,0" ClipToBounds="True">
                <Panel>
                    <Image x:Name="PictureBox" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtPlaceholder" Text="Sin Imagen / Cámara Apagada" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </Panel>
            </Border>

            <!-- Botones de Control -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" BoxShadow="0 2 8 0 #10000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="Opciones de Captura" FontWeight="Bold" FontSize="15" Foreground="#334155"/>
                    
                    <Button x:Name="BtnStartCamera" Content="Encender Cámara" Click="BtnStartCamera_Click" Background="#2563EB" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38"/>

                    <Button x:Name="BtnStopCamera" Content="Detener Cámara" Click="BtnStopCamera_Click" Background="#DC2626" 
                            Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" IsVisible="False"/>

                    <Button Content="Tomar Foto" Click="BtnTakePhoto_Click" Background="#0284C7" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38"/>

                    <Separator Margin="0,5"/>

                    <Button Content="Buscar foto local" Click="BtnBrowsePhoto_Click" Background="#475569" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38"/>

                    <Button Content="Limpiar" Click="BtnClear_Click" Background="#DC2626" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38"/>

                    <Separator Margin="0,5"/>

                    <Button Content="Guardar en BD" Click="BtnSaveToDb_Click" Background="#16A34A" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40" FontWeight="Bold"/>

                    <Separator Margin="0,10"/>

                    <Button Content="Preprocesamiento ➔" Click="BtnOpenPreprocessing_Click" Background="#7C3AED" Foreground="White" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="42" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="10">
            <TextBlock Text="Examen 1er Parcial - Computer Vision" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>